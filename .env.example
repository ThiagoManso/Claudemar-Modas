# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - CRM CLAUDEMAR MODAS
# ==============================================================================
# Copie este arquivo para .env e preencha com as chaves do seu projeto Firebase
# e Google Maps Platform.

# Chaves do Firebase (Consulte o console do Firebase em Configurações do Projeto)
VITE_FIREBASE_API_KEY=sua_api_key_do_firebase_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Chave da API do Google Maps (Google Maps JavaScript API ativa no GCP)
VITE_GOOGLE_MAPS_API_KEY=sua_chave_api_do_google_maps_aqui
