rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para checar se o usuário é admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Função para checar se o usuário é dono do documento
    function isOwner(resourceData) {
      return request.auth != null && resourceData.ownerId == request.auth.uid;
    }
    
    // Função para checar se está criando para si mesmo
    function isCreatingForSelf(requestData) {
      return request.auth != null && requestData.ownerId == request.auth.uid;
    }

    // 1. USERS COLLECTION
    match /users/{userId} {
      // Usuários só leem seu perfil, a menos que sejam admin
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    // 2. CONTACTS COLLECTION
    match /contacts/{contactId} {
      // Criação via form público (sem auth) ou por usuário logado
      allow create: if request.resource.data.keys().hasAny(['name', 'fullName', 'phone', 'createdAt']);
      // Leitura e modificação restrita
      allow read, update, delete: if request.auth != null && (isOwner(resource.data) || isAdmin());
    }

    // 3. SALES COLLECTION (Dívidas/Consignados)
    match /sales/{saleId} {
      allow create: if request.auth != null && (isCreatingForSelf(request.resource.data) || isAdmin());
      allow read, update: if request.auth != null && (isOwner(resource.data) || isAdmin());
      allow delete: if isAdmin();
      
      // 3.1. PAYMENTS SUBCOLLECTION (Histórico Imutável)
      match /payments/{paymentId} {
        allow create: if request.auth != null && (
          isAdmin() || 
          get(/databases/$(database)/documents/sales/$(saleId)).data.ownerId == request.auth.uid
        );
        allow read: if request.auth != null && (
          isAdmin() || 
          get(/databases/$(database)/documents/sales/$(saleId)).data.ownerId == request.auth.uid
        );
        // NINGUÉM pode editar ou deletar pagamentos
        allow update, delete: if false;
      }
    }
    
    // 4. PAYABLES COLLECTION (Despesas)
    match /payables/{payableId} {
      allow create: if request.auth != null && (isCreatingForSelf(request.resource.data) || isAdmin());
      allow read, update, delete: if request.auth != null && (isOwner(resource.data) || isAdmin());
    }
    
    // 5. PAYABLE CATEGORIES
    match /payableCategories/{categoryId} {
      allow read, create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
