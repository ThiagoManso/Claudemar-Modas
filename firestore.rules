rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para a coleção de contatos/clientes
    match /contacts/{contactId} {
      
      // Permitir leitura, atualização e exclusão APENAS para gestores autenticados via Firebase Auth
      allow read, update, delete: if request.auth != null;
      
      // Permitir escrita (Create) para qualquer usuário (Formulário Público externo)
      // Valida que o documento criado possui os campos obrigatórios básicos
      allow create: if request.resource.data.keys().hasAll(['fullName', 'phone', 'address', 'createdAt'])
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 2;
    }
    
    // Bloquear acesso a qualquer outra coleção não especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
